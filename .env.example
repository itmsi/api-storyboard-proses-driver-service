# ===== Aplikasi =====
APP_NAME=OGO Service API
APP_PORT=9060
# development | production
NODE_ENV=development
TZ=Asia/Jakarta
# id | en | zh
DEFAULT_LANGUAGE=id
# pisahkan dengan koma, contoh: https://admin.ogo.co.id
CORS_ORIGINS=*
# default: true di development, false di production
SWAGGER_ENABLED=true
# kosong = debug (dev) / info (prod)
LOG_LEVEL=

# ===== Database (PostgreSQL) =====
# Tanpa Docker: DB_HOST=localhost
# Docker + Postgres di host: DB_HOST=host.docker.internal
# Docker + profile local-db: DB_HOST=ogo-db, DB_PORT=5432
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=ogo_service
# Database khusus test end-to-end (isinya DIHAPUS tiap test jalan). Wajib berakhiran _test. Default: ogo_driver_test
# TEST_DB_NAME=ogo_driver_test
DB_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=10

# ===== Auth =====
# Wajib di production. Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# detik (24 jam)
JWT_ACCESS_TTL=86400
# detik (30 hari)
JWT_REFRESH_TTL=2592000
AUTH_MAX_LOGIN_ATTEMPTS=5
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15MIN=20

# ===== Upload & penyimpanan foto =====
# Batas ukuran file (byte). 10mb:10485760 20mb:20971520 50mb:52428800
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png
# nextcloud (WebDAV; media disajikan API di /storage) | s3 (MinIO / S3-compatible)
STORAGE_DRIVER=local
# contoh: https://api.ogo.co.id/storage atau URL CDN
STORAGE_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_PORT=443
S3_USE_SSL=true
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ogo-media
S3_REGION=us-east-1

# ===== Aplikasi Android (GET /config/public) =====
APP_LANGUAGES=id,en,zh
MOBILE_MIN_APP_VERSION=1.0.0
MOBILE_LATEST_APP_VERSION=1.0.0
MOBILE_UPDATE_URL=
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=
SUPPORT_LABEL=Hubungi admin
SUPPORT_PHONE=

# ===== Multi-tenant (database per client) =====
# env = tenant dev dari .env | remote = saas-api (control plane)
TENANT_REGISTRY=env
# Mode env: satu tenant memakai DB_* di atas. Untuk beberapa tenant isi TENANTS_JSON (JSON array
# [{"code":"OGO","name":"...","status":"active","connection":{"host","port","user","password","database"}}])
TENANT_DEV_CODE=OGO
TENANT_DEV_NAME=PT Owngo Logistics Indonesia
TENANTS_JSON=
# detik, cache hasil resolve kredensial client
TENANT_RESOLVE_TTL=300
TENANT_POOL_MAX=5
TENANT_MAX_POOLS=50
JWT_REFRESH_TTL_SHORT=86400
AUTH_LOCK_MINUTES=15

# ===== Integrasi saas-api (TENANT_REGISTRY=remote) =====
# URL internal saas-api (sudah termasuk /internal), timeout dalam milidetik
SAAS_API_INTERNAL_URL=http://localhost:9061/internal
SAAS_TIMEOUT_MS=5000
# Kunci resolve biasa (login/request) yang dikirim ke saas-api. Samakan dengan INTERNAL_API_KEY di saas-api.
INTERNAL_API_KEY=
# Kunci provisioning: dikirim ke saas-api untuk kredensial owner, DAN wajib dikirim saas-worker ke /internal API ini.
# Kosong = /internal nonaktif (404). Samakan dengan INTERNAL_PROVISIONING_KEY di saas-api.
INTERNAL_PROVISIONING_KEY=
# Kunci dekripsi password tenant (AES-256-GCM, base64 32 byte atau hex 64). Harus sama dengan saas-api. Wajib di production.
TENANT_DB_ENC_KEY=
TENANT_DB_ENC_KEY_VERSION=1
# Hanya mode env (dev/test): akun sistem MSI yang dibuat seeder. Di mode remote nilainya dari saas-api.
TENANT_DEV_SYSTEM_USERNAME=msi.support
TENANT_DEV_SYSTEM_PASSWORD=DevSupport-1234

# ===== Nextcloud (STORAGE_DRIVER=nextcloud) =====
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_PASSWORD=
NEXTCLOUD_WEBDAV_PATH=/remote.php/webdav
NEXTCLOUD_SHARE_API_PATH=/ocs/v1.php/apps/files_sharing/api/v1/shares
# Folder induk di Nextcloud; file disimpan di <folder>/media/<CLIENT>/<tahun>/<bulan>/<tanggal>/
NEXTCLOUD_UPLOAD_DIR=/OGO-Driver
NEXTCLOUD_TIMEOUT_MS=30000
