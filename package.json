{
  "name": "api-ogo-service",
  "version": "0.1.0",
  "private": true,
  "description": "OGO Service API - backend aplikasi ekspedisi pengiriman barang (OGO Driver)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src",
    "migrate": "knex --knexfile src/database/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile src/database/knexfile.js migrate:rollback",
    "migrate:make": "knex --knexfile src/database/knexfile.js migrate:make",
    "seed": "knex --knexfile src/database/knexfile.js seed:run",
    "seed:make": "knex --knexfile src/database/knexfile.js seed:make",
    "migrate:tenant": "node src/database/migrate-tenant.js",
    "migrate:tenant:rollback": "node src/database/migrate-tenant.js --rollback",
    "seed:tenant": "node src/database/migrate-tenant.js --seed",
    "test": "node --require ./test/setup.js --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.1",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.2.0",
    "joi": "^17.6.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^2.1.0",
    "minio": "^8.0.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.7.3",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^4.4.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^8.19.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "nodemon": "^3.1.10"
  }
}
